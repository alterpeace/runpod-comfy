# =============================================================================
# OPERATING MODE CONFIGURATION
# =============================================================================
# Operating Mode (auto-detected if not set)
# Valid values: local, serverless, pods
# - local: Development mode with direct WebUI access (default if no RUNPOD_POD_ID)
# - serverless: RunPod Serverless with handler API (pay-per-execution, auto-detected)
# - pods: RunPod Pods with persistent WebUI (continuous billing until terminated)
# Default: Auto-detected based on RUNPOD_POD_ID environment variable
# MODE=local

# =============================================================================
# COMFYUI CONFIGURATION
# =============================================================================
# ComfyUI server port (default: 8188)
COMFYUI_PORT=8188

# ComfyUI startup arguments (space-separated)
# Common options:
#   --use-sage-attention: Use Sage attention for better performance
#   --lowvram: Optimize for low VRAM GPUs
#   --normalvram: Normal VRAM usage
#   --highvram: High VRAM usage for better performance
#   --cpu: Run on CPU only (slow)
# Default: --use-sage-attention --lowvram
COMFYUI_ARGS=--use-sage-attention --lowvram

# Local data directory for models, custom_nodes, input, output, and user data.
# docker-compose.yml mounts ${COMFY_DATA_DIR}/<subdir> into the container at
# /comfyui/<subdir>. Defaults to ./.local (repo-local, gitignored placeholders).
#
# To reuse an existing ComfyUI install (e.g. on a separate data disk), set this
# to its parent directory:
#   COMFY_DATA_DIR=/media/chiral/data/comfy
# This makes the container use /media/chiral/data/comfy/models, .../custom_nodes,
# .../input, .../output, and .../user directly — no symlinks needed in the repo.
#
# Local dev scripts (install_ltx23.sh, update_custom_nodes.sh, clear_pycache.sh)
# also honor COMFY_DATA_DIR or CUSTOM_NODES_DIR / MODELS_DIR env vars for the
# same auto-detection.
# COMFY_DATA_DIR=./.local

# ComfyUI installation path (default: /comfyui)
# COMFYUI_PATH=/comfyui

# ComfyUI API URL (default: http://127.0.0.1:8188)
# COMFYUI_URL=http://127.0.0.1:8188

# Workflow execution timeout in seconds (default: 300, min: 5, max: 3600)
# TIMEOUT=300

# =============================================================================
# SSH CONFIGURATION (Optional)
# =============================================================================
# Enable SSH server for debugging and package installation
# Default: false
# ENABLE_SSH=true

# SSH public key for authentication (required if ENABLE_SSH=true)
# Add your public key here (from ~/.ssh/id_rsa.pub or similar)
# SSH_PUBLIC_KEY=ssh-rsa AAAA...your-public-key-here

# Alternative: Path to authorized_keys file in network storage
# SSH_AUTHORIZED_KEYS_PATH=/runpod-volume/authorized_keys

# =============================================================================
# CLOUDFLARE TUNNEL CONFIGURATION (Optional - stable WebUI access)
# =============================================================================
# cloudflared creates a userspace reverse tunnel to Cloudflare's edge, giving
# you a stable HTTPS URL that forwards to ComfyUI on port 8188. Works on
# RunPod serverless workers (no CAP_NET_ADMIN or TUN interface needed).
#
# Prerequisites (one-time setup, see docs/CLOUDFLARE_TUNNEL.md):
#   1. Create a named tunnel in Cloudflare Zero Trust dashboard
#   2. Download the credentials JSON file
#   3. Place it on the network volume (e.g. /runpod-volume/cloudflared-credentials.json)
#   4. Add a public hostname (e.g. comfyui.yourdomain.com) pointing to the tunnel
#
# Tunnel UUID from the Cloudflare dashboard
# CLOUDFLARED_TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the credentials JSON file (on the network volume so all workers share it)
# CLOUDFLARED_CREDENTIALS_PATH=/runpod-volume/cloudflared-credentials.json

# Public hostname configured for this tunnel (e.g. comfyui.yourdomain.com)
# CLOUDFLARED_HOSTNAME=comfyui.yourdomain.com

# =============================================================================
# REN (FL-MCP CHAT) API KEYS
# =============================================================================
# Ren (the ComfyUI chat interface from ComfyUI_FL-MCP) stores API keys using
# the OS keyring. In Docker containers, the OS keyring is unavailable
# (keyring.backends.fail.Keyring), so keys set via the UI only persist in
# process memory and are lost on backend restart.
#
# To persist API keys across container restarts, set them here as env vars.
# The FL-MCP CredentialStore checks env vars as a fallback before keyring.
# See: chat_config.py CredentialStore.get() ENV_KEYS

# OpenRouter API key (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI API key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# Anthropic API key (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=sk-ant-...

# Tavily search API key (https://tavily.com)
# TAVILY_API_KEY=tvly-...

# =============================================================================
# GITHUB CONTAINER REGISTRY (For Building Only)
# =============================================================================
# GitHub username and personal access token for pushing images to ghcr.io
# Only needed when building and pushing Docker images
# GITHUB_USERNAME=your-username
# GITHUB_TOKEN=ghp_...


# =============================================================================
# OUTPUT STORAGE CONFIGURATION
# =============================================================================
# Choose one of the following storage methods for generated outputs:
# Valid values: response, volume, s3
# Default: response

# Option 1: Return in Response (default)
# Base64 encodes images in API response - limited to ~10MB total
# Best for: Small outputs, simple workflows, testing
# STORAGE_TYPE=response

# Option 2: Network Volume Storage (recommended for RunPod)
# Stores outputs to network volume - persists across runs
# Best for: Large outputs, persistent storage, RunPod deployments
# STORAGE_TYPE=volume
# VOLUME_OUTPUT_PATH=/runpod-volume/outputs

# Option 3: S3/Cloud Storage
# Uploads outputs to S3-compatible storage and returns URLs
# Best for: Production deployments, CDN integration, long-term storage
# Requires: boto3 package (included in requirements.txt)
# STORAGE_TYPE=s3

# S3 Bucket Configuration (required when STORAGE_TYPE=s3)
# S3_BUCKET=my-comfyui-outputs

# AWS Credentials (required when STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# S3 Region (default: us-east-1)
# S3_REGION=us-east-1

# S3 Endpoint URL (optional - for S3-compatible services)
# Use for Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
# S3_ENDPOINT_URL=https://...

# S3 Prefix (optional - folder prefix in bucket, default: comfyui-outputs)
# S3_PREFIX=comfyui-outputs

# S3 Public Access (optional - set to true for public read access, default: false)
# S3_PUBLIC=false

# =============================================================================
# MODEL STORAGE BACKEND CONFIGURATION
# =============================================================================
# Choose storage backend for ComfyUI models and assets
# Valid values: network-volume, b2-mount, b2-sync
# Default: network-volume

# Option 1: Network Volume (default)
# Uses RunPod network volumes for model storage
# Cost: ~$100/TB/month
# Performance: Fast (local network)
# Best for: Small model libraries (<50GB), maximum performance
# STORAGE_BACKEND=network-volume

# Option 2: B2 Mount with rclone
# Mounts Backblaze B2 storage as filesystem with aggressive caching
# Cost: ~$5/TB/month storage + minimal egress
# Performance: Medium (network + cache)
# Best for: Large model libraries (100GB+), infrequent access
# STORAGE_BACKEND=b2-mount

# Option 3: B2 Sync on Boot
# Syncs B2 bucket contents to local storage on container startup
# Cost: ~$5/TB/month storage + egress for sync
# Performance: Fast (local after sync)
# Best for: Maximum performance with cost savings, frequent access
# STORAGE_BACKEND=b2-sync

# Backblaze B2 Configuration (required for b2-mount or b2-sync)
# Create a B2 account at https://www.backblaze.com/b2/cloud-storage.html
# Create a bucket and generate S3-compatible application keys

# B2 bucket name (required)
# B2_BUCKET=my-comfyui-models

# B2 S3-compatible access key ID (required)
# B2_KEY_ID=your_key_id_here

# B2 S3-compatible application key (required)
# B2_APP_KEY=your_app_key_here

# B2 S3 endpoint URL (required)
# Format: s3.<region>.backblazeb2.com
# Example: s3.us-west-004.backblazeb2.com
# B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# B2 bucket region (optional, default: us-west-004)
# B2_REGION=us-west-004

# B2 path prefix within bucket (optional, default: empty/root)
# Use to organize models in subdirectories
# B2_PATH=models

# rclone Mount Configuration (for b2-mount only)
# Cache size for rclone VFS cache (stored on network volume)
# Recommendations:
#   - SD 1.5 models: 20G
#   - SDXL models: 50G
#   - FLUX models: 100G+
# Default: 20G
# RCLONE_CACHE_SIZE=20G

# Cache expiration time (how long to keep cached files)
# Default: 24h
# RCLONE_CACHE_MAX_AGE=24h

# =============================================================================
# COMFYUI FRONTEND PROXY CONFIGURATION
# =============================================================================
# These settings configure the local proxy server that translates between
# the official ComfyUI Frontend (Vue.js, node-based UI) and the RunPod
# Serverless API (job queue). See docs/FRONTEND_SETUP.md for full guide.
#
# The proxy runs on PROXY_PORT and implements the subset of ComfyUI REST +
# WebSocket API the frontend needs, translating each call to RunPod API calls.

# RunPod Serverless endpoint ID (from RunPod console → Serverless → your endpoint)
# Required for proxy mode (frontend → proxy → RunPod serverless)
# RUNPOD_ENDPOINT_ID=your-endpoint-id-here

# RunPod API key (for submitting jobs and polling status)
# Generate at: https://www.runpod.io/console/user/settings → API Keys
# RUNPOD_API_KEY=your-runpod-api-key

# Proxy server port — must match DEV_SERVER_COMFYUI_URL in frontend/.env
# Default: 8188 (same as ComfyUI, so frontend config doesn't change)
# PROXY_PORT=8188

# Path to cached object_info JSON (for node palette rendering without a live server)
# Refresh with: python scripts/fetch_object_info.py --source local|runpod
# Default: config/object_info_cache.json
# OBJECT_INFO_CACHE=config/object_info_cache.json

# Polling interval for RunPod job status checks (seconds)
# Lower = faster UI updates but more API calls
# Default: 2
# PROXY_POLL_INTERVAL=2

# Local storage directory for uploaded images (img2img workflows)
# Images are stored here and embedded as base64 in the job payload
# Default: ./.local/input
# PROXY_UPLOAD_DIR=./.local/input

# Proxy debug mode — logs all protocol translations to console
# Default: false
# PROXY_DEBUG=false