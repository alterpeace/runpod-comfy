# =============================================================================
# EXAMPLE: Large Model Library (100GB+)
# =============================================================================
# Best for: FLUX models, large collections, multiple model types, production
# Cost: ~$0.50/month for 100GB on B2 vs $10/month on network volume
# Performance: Medium (network + cache), first access 30-60s, cached instant
# Savings: ~$9.50/month (95% cost reduction)

# Storage Backend Configuration
STORAGE_BACKEND=b2-mount

# Backblaze B2 Configuration
B2_BUCKET=my-comfyui-models
B2_KEY_ID=your_key_id_here
B2_APP_KEY=your_app_key_here
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PATH=models  # Optional: subdirectory within bucket

# rclone Mount Configuration
# Cache size: 100GB+ for FLUX models (4-5 FLUX models or 15-20 SDXL models)
# Stored on network volume at /runpod-volume/rclone-cache
RCLONE_CACHE_SIZE=100G
RCLONE_CACHE_MAX_AGE=24h

# =============================================================================
# USAGE NOTES
# =============================================================================
# 1. Replace B2_KEY_ID and B2_APP_KEY with your actual credentials
# 2. Update B2_BUCKET with your bucket name
# 3. Adjust B2_ENDPOINT and B2_REGION to match your bucket location
# 4. Large cache size (100GB) allows caching multiple FLUX models
# 5. Cache is stored on network volume (persists across restarts)
# 6. First access downloads from B2, subsequent access is instant
# 7. rclone automatically manages cache (LRU eviction when full)
# 8. Recommended network volume size: 150GB+ (100GB cache + outputs)

# =============================================================================
# PERFORMANCE CHARACTERISTICS
# =============================================================================
# Cold start (first access):
#   - FLUX model (23GB): ~2-3 minutes
#   - SDXL model (6GB): ~30-60 seconds
#   - SD 1.5 model (4GB): ~20-30 seconds
#
# Warm start (cached):
#   - All models: Instant (equivalent to local disk)
#   - Cache hit rate: Typically >95% after initial warmup
#
# Cache capacity:
#   - 100GB cache can hold:
#     * ~4-5 FLUX models (23GB each)
#     * ~15-20 SDXL models (6GB each)
#     * ~25 SD 1.5 models (4GB each)

# =============================================================================
# COST BREAKDOWN (100GB library)
# =============================================================================
# B2 Storage: 100GB × $0.005/GB/month = $0.50/month
# B2 Egress: Free via Cloudflare (or $1/GB for first download)
# Network Volume: 150GB for cache + outputs = $15/month
# Total: ~$15.50/month vs $25/month for 250GB network volume
# Savings: ~$9.50/month (38% cost reduction)
#
# Alternative: 200GB network volume only = $20/month
# With B2: $15.50/month (23% savings)

# =============================================================================
# OPTIMIZATION TIPS
# =============================================================================
# 1. Increase cache size if you have more network volume space
#    RCLONE_CACHE_SIZE=150G  # For 200GB network volume
#
# 2. Increase cache max age to keep models longer
#    RCLONE_CACHE_MAX_AGE=72h  # Keep for 3 days
#
# 3. Pre-warm cache by accessing models after startup
#    ls -R /comfyui/models  # Lists all models, triggers download
#
# 4. Monitor cache usage
#    du -sh /runpod-volume/rclone-cache
#
# 5. Consider hybrid approach: bake most-used models into Docker image
