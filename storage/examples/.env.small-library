# =============================================================================
# EXAMPLE: Small Model Library (< 20GB)
# =============================================================================
# Best for: SD 1.5 models, testing, development, small collections
# Cost: ~$0.10/month for 20GB on B2 vs $2/month on network volume
# Performance: Medium (network + cache), first access 30-60s, cached instant
# Sync time: 2-5 minutes initial sync

# Storage Backend Configuration
STORAGE_BACKEND=b2-mount

# Backblaze B2 Configuration
B2_BUCKET=my-comfyui-models
B2_KEY_ID=your_key_id_here
B2_APP_KEY=your_app_key_here
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PATH=models  # Optional: subdirectory within bucket

# rclone Mount Configuration
# Cache size: 20GB is sufficient for SD 1.5 models (4-5 models)
RCLONE_CACHE_SIZE=20G
RCLONE_CACHE_MAX_AGE=24h

# =============================================================================
# USAGE NOTES
# =============================================================================
# 1. Replace B2_KEY_ID and B2_APP_KEY with your actual credentials
# 2. Update B2_BUCKET with your bucket name
# 3. Adjust B2_ENDPOINT and B2_REGION to match your bucket location
# 4. First model access will download from B2 (30-60s for 5GB model)
# 5. Subsequent access is instant (cached on network volume)
# 6. Cache persists across container restarts
# 7. Models are automatically evicted from cache when space is needed (LRU)

# =============================================================================
# COST BREAKDOWN (20GB library)
# =============================================================================
# B2 Storage: 20GB × $0.005/GB/month = $0.10/month
# B2 Egress: Free via Cloudflare (or $0.01/GB)
# Network Volume: 50GB minimum for cache = $5/month
# Total: ~$5.10/month vs $2/month for network volume only
# 
# Note: For small libraries, network volume may be more cost-effective.
# B2 becomes cost-effective at 50GB+ when you need the network volume anyway.
